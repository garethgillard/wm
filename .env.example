# Copy to .env and fill in:  cp .env.example .env

# Passcode people must enter before they can see or join the chat.
# Leave empty to let anyone with the link in.
PARTY_PASSCODE=

# Your organiser code: unlocks editing, moderation and "Reset everything".
# Use something long and random, e.g. the output of:  openssl rand -base64 18
ADMIN_CODE=

# Optional: keep the data in Postgres instead of the SQLite file (needed on hosts
# whose disk is wiped on restart, like Render's free tier).
DATABASE_URL=

# Port on the server's localhost that the reverse proxy forwards to.
PARTY_PORT=8080

# Limits
MAX_PLAYERS=200
